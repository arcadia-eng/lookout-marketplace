      "license": "MIT",
      "homepage": "https://github.com/arcadia-eng/lookout-marketplace/tree/main/connectors/gmail",
      "repository": {
        "type": "git",
        "url": "https://github.com/arcadia-eng/lookout-marketplace",
        "directory": "connectors/gmail"
      },
      "icon": "https://cdn.jsdelivr.net/gh/arcadia-eng/lookout-marketplace@gmail-v1.0.0/assets/gmail.svg",
      "lookout": ">=0.2.0",
      "publisher": { "name": "Arcadia", "url": "https://github.com/arcadia-eng" },
      "source": {
        "type": "github",
        "repo": "arcadia-eng/lookout-marketplace",
        "path": "connectors/gmail",
        "ref": "gmail-v1.0.0"
      },
      "availability": "preview",
      "audience": ["aecb8b4ad433e6c1bf263d9a152e912135aa8c91af22442cdd120e5d4cc700b3"],
      "capabilities": {
        "can": ["Search and read mail and drafts", "Write drafts and replies", "Label and archive", "Mark read or unread", "Move to Trash or Spam"],
